{
  "name": "dsh-memory",
  "version": "0.2.0",
  "description": "Persistent vector memory for DeepSeek Harness backed by MongoDB: captures turns, injects relevant fragments before each step, and exposes memory_search / memory_save / memory_forget / memory_stats. Installable as a DSH profile bundle.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib",
    "scripts",
    "test",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "mongodb",
    "vector-search",
    "agent-memory",
    "cordis-plugin"
  ],
  "license": "BSD-3-Clause",
  "author": "Alberto Muñoz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertoSosaMunoz/dsh-memory.git"
  },
  "homepage": "https://github.com/albertoSosaMunoz/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/albertoSosaMunoz/dsh-memory/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/unit.test.mjs test/store.test.mjs test/plugin.test.mjs",
    "test:unit": "node --test test/unit.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "mongodb": "^6.20.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "cordis": {
      "optional": true
    },
    "schemastery": {
      "optional": true
    }
  }
}
